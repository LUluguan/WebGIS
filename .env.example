# 数据库连接(可选; 不配置/连不上时, 服务层自动回退读取本地 flood_out/ 文件)
FLOOD_DB_HOST=localhost
FLOOD_DB_PORT=5432
FLOOD_DB_NAME=flood_analysis
FLOOD_DB_USER=postgres
FLOOD_DB_PASSWORD=123456

# 服务端口
FLOOD_PORT=8001

# ===== GeoScene Online 服务(可选; 满足竞赛"不脱离GeoScene服务器端"要求) =====
# 在 GeoScene Online(geoscene.cn) 或 ArcGIS Online 发布托管要素/影像服务后, 填入 REST 服务 URL;
# 未配置或不可用时, 前端自动回退读取本地数据。
# 注意: URL 结尾必须带图层号(如 /0), 前端会再拼接 /query?where=return_yr=<T>&f=geojson
GEOSCENE_EXTENT_URL=
# 示例(GeoScene Online): https://www.geosceneonline.cn/server/rest/services/Hosted/<项目名>/FeatureServer/0
# 示例(ArcGIS Online):     https://services1.arcgis.com/<orgId>/arcgis/rest/services/<folder>/extent/FeatureServer/0
GEOSCENE_DEPTH_URL=
# 示例: https://services1.arcgis.com/<orgId>/arcgis/rest/services/<folder>/depth/ImageServer
